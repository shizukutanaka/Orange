<?xml version="1.0" encoding="utf-8"?>
<!--
  Rams #6 (honest) applied at the OS level.

  Android 12+ respects this file when deciding what to include in:
   - Auto Backup (Google Drive)
   - Device-to-device migration (new phone setup)

  Orange excludes EVERYTHING. No prefs, no files, no databases. If the
  user reinstalls, they start fresh. This makes two promises explicit:

    1. The spam cache and outbound-known set never leave the device,
       even via Google's backup path. Competitors often overlook this
       and quietly sync sensitive data via default Auto Backup.

    2. Uninstall is a complete wipe. A user removing Orange from their
       phone knows with certainty that nothing about their call history
       survives.

  allowBackup=false in the manifest is the belt; this file is the suspenders.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>
