<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and below backup rules. Complement to data_extraction_rules.xml
  which covers Android 12+. Exclude everything — same rationale as in
  data_extraction_rules.xml: uninstall is complete deletion, no leak path.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="file" path="."/>
    <exclude domain="external" path="."/>
    <exclude domain="root" path="."/>
</full-backup-content>
